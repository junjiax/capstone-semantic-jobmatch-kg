# Dummy, non-secret values for the disposable test environment (docker-compose.test.yml).
# Copy to .env.test if you want to override; never reuse real credentials here.
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=postgres
TEST_NEO4J_AUTH=neo4j/test-password-123
TEST_NEO4J_PASSWORD=test-password-123
TEST_SECRET_KEY=test-secret-key-not-for-production

# Used by pytest integration tests. The database name MUST end with _test.
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:55432/jobmatch_test
